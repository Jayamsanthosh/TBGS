<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- Rule 1: TBGS Approval API Proxy -->
        <!-- /tbgs-approval/api/*  →  http://localhost:5000/api/* (shared backend) -->
        <rule name="TBGS Approval API Proxy" stopProcessing="true">
          <match url="^api(.*)" />
          <action type="Rewrite" url="http://localhost:5000/api{R:1}" />
        </rule>

        <!-- Rule 2: TBGS Approval Frontend Root -->
        <!-- /tbgs-approval/  →  http://localhost:4000/tbgs-approval -->
        <rule name="TBGS Approval Frontend Root" stopProcessing="true">
          <match url="^/?$" />
          <action type="Rewrite" url="http://localhost:4000/tbgs-approval" />
        </rule>

        <!-- Rule 3: TBGS Approval Frontend Proxy -->
        <!-- /tbgs-approval/*  →  http://localhost:4000/tbgs-approval/* -->
        <rule name="TBGS Approval Frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4000/tbgs-approval/{R:1}" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
