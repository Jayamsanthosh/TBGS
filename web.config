<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- Rule 1: TBGS API Proxy -->
        <!-- /tbgs-main/api/*  →  http://localhost:5000/api/* -->
        <rule name="TBGS API Proxy" stopProcessing="true">
          <match url="^tbgs-main/api(.*)" />
          <action type="Rewrite" url="http://localhost:5000/api{R:1}" />
        </rule>

        <!-- Rule 2: TBGS Frontend Proxy -->
        <!-- /tbgs-main/*  →  http://localhost:3000/tbgs-main/* -->
        <rule name="TBGS Frontend" stopProcessing="true">
          <match url="^tbgs-main(.*)" />
          <action type="Rewrite" url="http://localhost:3000/tbgs-main{R:1}" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>